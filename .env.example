# local: standalone participant 1 demo, saved only in this browser.
# api: use the participant 2 endpoints documented in docs/INTEGRATION.md.
NEXT_PUBLIC_DATA_MODE=local
# Explicitly seed participant 3's five published tasks, five separate drafts, and proposals in local mode.
# Existing browser tasks are retained. At 0, examples are added only by the UI button.
NEXT_PUBLIC_COLLAB_FIXTURES=0
# Same-origin API by default. No trailing slash. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=
# Public HTTPS address when using a tunnel, without /tasks/new. Restart dev after changing.
# Example: https://your-tunnel.trycloudflare.com
APP_ORIGIN=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# live uses the configured model; mock always returns explicit fallback.
AI_MODE=mock
# Shared demonstration business identity, not individual authentication.
DEMO_OWNER_ID=demo-business
